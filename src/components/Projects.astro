---
import { Image } from "astro:assets";
import type { Profile, Locale, Project } from "../data/types";
import { useTranslations } from "../i18n/ui";
import Icon from "./Icon.astro";
import pscImage from "../assets/psc-challenge.png";

interface Props {
  profile: Profile;
  locale: Locale;
}
const { profile, locale } = Astro.props;
const t = useTranslations(locale);
const images = { "psc-challenge": pscImage } as const;
const featured = profile.projects.filter((p) => p.featured);
const others = profile.projects.filter((p) => !p.featured);
const repoName = (p: Project) => p.repo.replace("https://github.com/", "");
---

<section id="projetos" class="section" aria-labelledby="projetos-title">
  <div class="container">
    <h2 id="projetos-title" class="section-title" data-index="03.">
      {t("projects.title")}
    </h2>
    <p class="lead">{t("projects.subtitle")}</p>

    <div class="cards">
      {featured.map((p) => (
        <article class:list={["card", { wide: p.image }]}>
          {p.image && (
            <Image
              src={images[p.image]}
              alt={t("projects.imageAlt")}
              widths={[480, 720, 960]}
              sizes="(max-width: 900px) 100vw, 28rem"
              class="cover"
            />
          )}
          <div class="content">
            {p.context && <p class="context">{p.context}</p>}
            <h3>{p.name}</h3>
            <p class="tagline">{p.tagline}</p>
            <p class="description">{p.description}</p>
            <ul class="highlights">
              {p.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <ul class="tags" aria-label="Stack">
              {p.stack.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
            <div class="links">
              <a href={p.repo} target="_blank" rel="noopener noreferrer">
                <Icon name="github" />
                {t("projects.code")}
                <span class="visually-hidden">
                  : {repoName(p)} {t("newTab")}
                </span>
              </a>
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener noreferrer">
                  <Icon name="play" />
                  {t("projects.demo")}
                  <span class="visually-hidden">
                    : {p.name} {t("newTab")}
                  </span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    {others.length > 0 && (
      <>
        <h3 class="more-title">{t("projects.more")}</h3>
        <ul class="more">
          {others.map((p) => (
            <li>
              <a href={p.repo} class="more-name" target="_blank" rel="noopener noreferrer">
                {p.name}
                <span class="visually-hidden"> {t("newTab")}</span>
              </a>
              <p>{p.tagline}.</p>
              <p class="context">{p.context}</p>
              <ul class="tags" aria-label="Stack">
                {p.stack.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>

<style>
  .lead {
    margin-top: -1rem;
    margin-bottom: 2rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card.wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  }
  /* A prévia é 2:1 e tem texto: mostrar inteira (sem corte), alinhada ao título do projeto. */
  .cover {
    align-self: start;
    width: calc(100% - 3rem);
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: contain;
    margin: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    height: 100%;
  }
  .context {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  h3 {
    font-size: 1.3rem;
  }
  .tagline {
    margin-top: -0.4rem;
    color: var(--accent);
    font-weight: 600;
  }
  .description {
    color: var(--muted);
    font-size: 0.98rem;
  }
  .highlights {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
    font-size: 0.96rem;
  }
  .highlights li::marker {
    color: var(--accent);
  }
  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .more-title {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }
  .more {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .more li {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  .more-name {
    font-weight: 700;
    font-size: 1.05rem;
  }
  @media (max-width: 900px) {
    .cards,
    .card.wide {
      grid-template-columns: 1fr;
    }
    .cover {
      width: calc(100% - 2rem);
      margin: 1rem 1rem 0;
    }
  }
</style>
