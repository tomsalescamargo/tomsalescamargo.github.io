---
import type { Profile, Locale } from "../data/types";
import { useTranslations } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  profile: Profile;
  locale: Locale;
}
const { profile, locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="contato" class="section" aria-labelledby="contato-title">
  <div class="container box">
    <h2 id="contato-title" class="section-title" data-index="06.">
      {t("contact.title")}
    </h2>
    <p class="lead">{t("contact.text")}</p>
    <div class="cta">
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>
        <Icon name="mail" />
        {t("contact.email")}
      </a>
      <a class="btn" href={profile.linkedin}>
        <Icon name="linkedin" />
        LinkedIn
      </a>
      <a class="btn" href={profile.github}>
        <Icon name="github" />
        GitHub
      </a>
      <a class="btn" href={profile.cv} download>
        <Icon name="download" />
        {t("hero.cv")}
      </a>
    </div>
    <p class="email">{profile.email}</p>
  </div>
</section>

<style>
  .box {
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .box .section-title {
    justify-content: center;
  }
  .lead {
    margin-top: -0.75rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .email {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
