---
import type { Profile, Locale } from "../data/types";
import { useTranslations } from "../i18n/ui";

interface Props {
  profile: Profile;
  locale: Locale;
}
const { profile, locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="habilidades" class="section" aria-labelledby="habilidades-title">
  <div class="container">
    <h2 id="habilidades-title" class="section-title" data-index="04.">
      {t("skills.title")}
    </h2>
    <div class="groups">
      {profile.skills.map((g) => (
        <div class="group">
          <h3>{g.name}</h3>
          <ul class="tags">
            {g.items.map((s) => (
              <li class="tag">{s}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.25rem;
  }
  .group {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  h3 {
    font-size: 1rem;
    margin-bottom: 0.85rem;
  }
</style>
