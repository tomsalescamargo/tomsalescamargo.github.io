---
import type { Profile, Locale } from "../data/types";
import { useTranslations } from "../i18n/ui";

interface Props {
  profile: Profile;
  locale: Locale;
}
const { profile, locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="sobre" class="section" aria-labelledby="sobre-title">
  <div class="container">
    <h2 id="sobre-title" class="section-title" data-index="01.">
      {t("about.title")}
    </h2>
    <div class="prose">
      {profile.about.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .prose {
    display: grid;
    gap: 1.1rem;
    max-width: 46rem;
    font-size: 1.08rem;
  }
</style>
